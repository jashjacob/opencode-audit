{
  "name": "opencode-audit",
  "version": "0.1.0",
  "description": "Parallel code audit and verified fixes for OpenCode",
  "type": "module",
  "license": "MIT",
  "author": "Jash Jacob",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jashjacob/opencode-audit.git"
  },
  "homepage": "https://github.com/jashjacob/opencode-audit#readme",
  "bugs": {
    "url": "https://github.com/jashjacob/opencode-audit/issues"
  },
  "keywords": ["opencode", "audit", "code-review", "agents", "plugin"],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "LICENSE", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/*.test.js\""
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.20"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.18.20",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  }
}
